[Unit]
Description=ruster forwarding element
PartOf=ruster.target
BindsTo=ruster-netns.service
After=ruster-netns.service

[Service]
Type=notify
EnvironmentFile=/etc/ruster/ruster.env
NetworkNamespacePath=/run/netns/ruster
ExecStart=/usr/local/bin/ruster-fe $RUSTER_FE_OPTIONS $RUSTER_PORTS
Restart=on-failure
RestartSec=1
# The FE waits up to a second for frames it gave the kernel.
TimeoutStopSec=10
