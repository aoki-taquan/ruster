# Read by the ruster units. Install as /etc/ruster/ruster.env.

# The devices the FE forwards on, in the order ruster-fe takes them. They move into
# the router's namespace while ruster.target runs.
RUSTER_PORTS="lan wan"

# More options for ruster-fe, such as --backend af-packet or --workers 2.
RUSTER_FE_OPTIONS=""

# The route sources ribd accepts (NAME:PREFERENCE[:HOLD_MS]). Empty means confd:1.
# Add the bridges that write routes: dhcpc and pppoed with default-route, and
# frr (frr:20:65000).
RUSTER_RIBD_SOURCES=""

# More options for ruster-kea, such as --dhcp6 /etc/kea/ruster-dhcp6.json.
RUSTER_KEA_OPTIONS=""
