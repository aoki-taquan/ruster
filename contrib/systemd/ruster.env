# Read by the ruster units. Install as /etc/ruster/ruster.env.

# The devices the FE forwards on, in the order ruster-fe takes them. They move into
# the router's namespace while ruster.target runs.
RUSTER_PORTS="lan wan"

# More options for ruster-fe, such as --backend af-packet or --workers 2.
RUSTER_FE_OPTIONS=""

# The route sources ribd accepts (NAME:PREFERENCE). Empty means confd:1.
RUSTER_RIBD_SOURCES=""
