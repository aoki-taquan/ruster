# Read by the ruster units. Install as /etc/ruster/ruster.env.

# The devices the FE forwards on, in the order ruster-fe takes them. They move into
# the router's namespace while ruster.target runs.
RUSTER_PORTS="lan wan"

# More options for ruster-fe, such as --backend af-packet, --workers 2 or
# --nat-sessions 65536 (see the top of crates/fe/src/bin/ruster-fe/main.rs).
RUSTER_FE_OPTIONS=""

# The route sources ribd accepts (NAME:PREFERENCE[:HOLD_MS[:DROP_MS]]). Empty means
# confd:1. Add the bridges that write routes: dhcpc and pppoed with default-route,
# and frr (frr:20:65000). With DROP_MS, a source that stays away that long loses its
# routes (frr:20:65000:120000); without it, they stay.
RUSTER_RIBD_SOURCES=""

# More options for ruster-kea, such as --dhcp6 /etc/kea/ruster-dhcp6.json.
RUSTER_KEA_OPTIONS=""
