[Unit]
Description=ruster router namespace
PartOf=ruster.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/ruster/ruster.env
ExecStart=/usr/local/lib/ruster/ruster-netns up ruster $RUSTER_PORTS
ExecStop=/usr/local/lib/ruster/ruster-netns down ruster $RUSTER_PORTS
