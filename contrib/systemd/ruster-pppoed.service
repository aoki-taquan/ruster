[Unit]
Description=ruster PPPoE client
PartOf=ruster.target
BindsTo=ruster-netns.service
Wants=ruster-confd.service
After=ruster-netns.service ruster-confd.service

[Service]
Type=notify
NetworkNamespacePath=/run/netns/ruster
ExecStart=/usr/local/bin/ruster-pppoed
Restart=on-failure
RestartSec=1

[Install]
WantedBy=ruster.target
