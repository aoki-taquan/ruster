[Unit]
Description=ruster bridge to Unbound
PartOf=ruster.target
Before=unbound.service
BindsTo=ruster-netns.service
Wants=ruster-confd.service
After=ruster-netns.service ruster-confd.service

[Service]
Type=notify
NetworkNamespacePath=/run/netns/ruster
ExecStart=/usr/local/bin/ruster-unbound /etc/unbound/unbound.conf.d/ruster.conf
Restart=on-failure
RestartSec=1

[Install]
WantedBy=ruster.target
