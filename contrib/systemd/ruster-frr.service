[Unit]
Description=ruster bridge to FRR
PartOf=ruster.target
Before=frr.service
BindsTo=ruster-netns.service
Wants=ruster-confd.service
After=ruster-netns.service ruster-confd.service ruster-ribd.service

[Service]
Type=notify
NetworkNamespacePath=/run/netns/ruster
ExecStart=/usr/local/bin/ruster-frr /etc/frr/frr.conf
Restart=on-failure
RestartSec=1

[Install]
WantedBy=ruster.target
