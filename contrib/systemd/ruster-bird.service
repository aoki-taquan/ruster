[Unit]
Description=ruster bridge to bird-rs
PartOf=ruster.target
BindsTo=ruster-netns.service
Wants=ruster-confd.service bird-rs.service
After=ruster-netns.service ruster-confd.service ruster-ribd.service bird-rs.service

[Service]
Type=notify
NetworkNamespacePath=/run/netns/ruster
ExecStart=/usr/local/bin/ruster-bird --birdc "/usr/local/bin/birdc-rs -s /run/bird-rs.ctl" /etc/bird-rs/bird.conf
Restart=on-failure
RestartSec=1

[Install]
WantedBy=ruster.target
