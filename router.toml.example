[meta]
schema = "ruster/v0.1"
hostname = "ruster-lab"

[dataplane]
# Backend selection: "dpdk", "afpacket", or "mock".
#   dpdk     — DPDK poll-mode driver (requires --features dpdk at build time)
#   afpacket — Linux AF_PACKET raw sockets (Linux only, requires CAP_NET_RAW)
#   mock     — No real I/O (for testing / development)
backend = "dpdk"
lcore_list = "0-3"
memory_mb = 2048
rx_queue_size = 1024
tx_queue_size = 1024

[[interfaces]]
name = "wan0"
port_id = 0
role = "wan"
admin_up = true
mtu = 1500
mac = "02:00:00:00:10:01"
ipv4_addrs = ["203.0.113.2/24"]
zone = "wan"
l2_domain = "bd-wan"
# linux_if = "eth1"  # optional: map to Linux device name (for afpacket backend)

[[interfaces]]
name = "lan0"
port_id = 1
role = "lan"
admin_up = true
mtu = 1500
mac = "02:00:00:00:20:01"
ipv4_addrs = ["192.168.10.1/24"]
zone = "lan"
l2_domain = "bd-lan"
# linux_if = "eth2"

[[interfaces]]
name = "lan1"
port_id = 2
role = "lan"
admin_up = true
mtu = 1500
mac = "02:00:00:00:20:02"
ipv4_addrs = []
zone = "lan"
l2_domain = "bd-lan"

[l2]
mac_table_max_entries = 131072
mac_aging_sec = 300
arp_table_max_entries = 65536
arp_timeout_sec = 1200
bridge_domains = [
  { name = "bd-wan", members = ["wan0"] },
  { name = "bd-lan", members = ["lan0", "lan1"] }
]

[routing]
ipv4_static_routes = [
  { prefix = "0.0.0.0/0", next_hop = "203.0.113.1", out_if = "wan0", metric = 10 }
]

[nat]
enabled = true
mode = "napt44"
external_if = "wan0"
hairpin = true
session_table_max_entries = 1048576
tcp_established_timeout_sec = 7440
tcp_transitory_timeout_sec = 120
udp_timeout_sec = 60
icmp_timeout_sec = 30
port_forwards = [
  { name = "web80", proto = "tcp", external_port = 80, internal_addr = "192.168.10.100", internal_port = 80 }
]

[firewall]
enabled = true
default_input = "drop"
default_forward = "drop"
default_output = "accept"
allow_established_related = true
rules = [
  { name = "allow-lan-to-wan", chain = "forward", action = "accept", proto = "any", src_zone = "lan", dst_zone = "wan", state = ["new", "established", "related"] },
  { name = "allow-lan-input-icmp", chain = "input", action = "accept", proto = "icmp", src_zone = "lan", dst_zone = "any", state = ["new"] }
]

# ── SRv6 (Segment Routing over IPv6) ──────────────────────────────
# Optional: enable SRv6 uSID processing.
# RFC 8986 (SRv6 Network Programming), RFC 8754 (IPv6 SRH)
# [srv6]
# locator_block = "fd00::"
# block_len = 32
# usid_len = 16
# local_sids = [
#   { sid = "fd00::1", action = "end" },
#   { sid = "fd00::2", action = "end_dt4", table = "default" },
#   { sid = "fd00::/32", action = "un" },
# ]
